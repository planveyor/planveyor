{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planveyor canonical unittest shard manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "baseline_head",
    "weighting",
    "zero_test_modules",
    "shards",
    "local_profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "baseline_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "weighting": {
      "type": "object"
    },
    "zero_test_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^test_[A-Za-z0-9_]+$"
      }
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "selectors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "module"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "module": {
                      "type": "string",
                      "pattern": "^test_[A-Za-z0-9_]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "module",
                    "class"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "module": {
                      "type": "string",
                      "pattern": "^test_[A-Za-z0-9_]+$"
                    },
                    "class": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "module",
                    "ids"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "module": {
                      "type": "string",
                      "pattern": "^test_[A-Za-z0-9_]+$"
                    },
                    "ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^test_[A-Za-z0-9_]+\\.[A-Za-z_][A-Za-z0-9_]*\\.test_[A-Za-z0-9_]+$"
                      }
                    }
                  }
                }
              ]
            }
          },
          "historical_unsplit_seconds": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "local_profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "3": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "shards"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "shards": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              }
            }
          }
        },
        "4": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "shards"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "shards": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$comment": "The stdlib runner additionally verifies file membership, unique shard/group IDs, local coverage, dynamic selector matching and exact-once canonical TestCase IDs. JSON Schema alone cannot establish these invariants."
}
