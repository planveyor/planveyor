{
  "schema_version": "ai_gate_policy.v1",
  "verdict_defaults": {
    "unconfirmed_detection": "WARN",
    "missing_optional_scanner": "WARN",
    "scanner_error": "WARN",
    "satd_candidate": "WARN"
  },
  "detection": {
    "author_markers": [
      "openai",
      "anthropic",
      "copilot",
      "cursor",
      "assistant",
      "bot",
      "gpt",
      "claude"
    ],
    "message_markers": [
      "ai-assisted",
      "ai assisted",
      "chatgpt",
      "codex",
      "claude",
      "copilot",
      "cursor",
      "generated-by",
      "generated by",
      "llm",
      "model:"
    ],
    "session_markers": [
      "session sid",
      "codex session",
      "trace_id",
      "thread id",
      "parent thread id"
    ]
  },
  "path_rules": {
    "allow": [
      "scripts/**",
      "docs/tools/**",
      "docs/reviews/**",
      "docs/code_reviews/**",
      "docs/playbooks/**"
    ],
    "block": [
      ".github/workflows/**",
      "secrets/**",
      "*.pem",
      "*.key"
    ],
    "warn_outside_allowlist": true
  },
  "diff_limits": {
    "max_changed_files_warn": 20,
    "max_changed_files_block": 60,
    "max_lines_added_warn": 600,
    "max_lines_added_block": 1800
  },
  "security_scans": {
    "gitleaks": {
      "enabled": true,
      "required": false
    },
    "semgrep": {
      "enabled": false,
      "required": false,
      "config": ""
    }
  },
  "satd_candidates": {
    "warn_on_any": true,
    "warn_on_blocker_signal": true
  }
}
